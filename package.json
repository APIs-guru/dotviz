{
  "name": "dotviz",
  "version": "0.0.7",
  "private": true,
  "description": "A modern, browser-native graph visualization library that reimagines Graphviz for the web",
  "keywords": [
    "WebAssembly",
    "graphviz",
    "wasm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/APIs-guru/dotviz.git"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "preversion": "bash ./scripts/check-git.sh && npm ci --ignore-scripts",
    "version": "npm test",
    "build:npm": "node scripts/build-npm.ts",
    "test": "npm run lint && npm run testonly && npm run fmt:check && npm run check:spelling",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check:spelling": "cspell --cache --no-progress \"**/*\"",
    "testonly": "vitest run --coverage test/*.test.ts",
    "docs": "typedoc types/index.d.ts"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "12.1.4",
    "@types/node": "24.6.1",
    "@vitest/coverage-v8": "4.1.7",
    "@viz-js/viz": "3.17.0",
    "cspell": "9.2.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "jsdom": "27.0.0",
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0",
    "oxlint-tsgolint": "0.23.0",
    "rollup": "4.52.3",
    "rollup-plugin-dts": "6.4.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
